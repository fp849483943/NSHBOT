# Discord Bot Token：請到 Discord Developer Portal 複製 Bot Token
DISCORD_BOT_TOKEN=貼上你的DiscordBotToken

# xAI / Grok API Key：文字對話、圖片識別、Grok 圖像生成
XAI_API_KEY=貼上你的xAI_API_Key
XAI_API_URL_TEXT=https://api.x.ai/v1/responses
XAI_MODEL=grok-4.3
XAI_VISION_MODEL=grok-4.3

# GPT IMAGE2 / 第三方圖片 API
# 目前舊版程式把這個欄位命名為 openai_api_key，可填 APIMart 或相容服務 Key
OPENAI_API_KEY=貼上你的GPT_IMAGE2或第三方圖片API_Key

# 影片 / 動畫生成 API：可接 Runway、Kling、Luma 或其他相容第三方服務
VIDEO_API_URL=
VIDEO_API_KEY=
VIDEO_MODEL=

# 遊戲資訊查詢 API：可留空，只用 RSS；也可接自己的搜尋服務
GAME_SEARCH_API_URL=
GAME_SEARCH_API_KEY=

# 中央氣象署開放資料 API Key：地震正式報告查詢
CWA_API_KEY=

# 指令前綴，預設為 !
COMMAND_PREFIX=!

# 日誌等級：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
